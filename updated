<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0"/>
<title>Mohammed Shamil — Data Analyst</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Mono:wght@300;400;500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
/* ════════════════════════════════════════════════
   CSS VARIABLES
════════════════════════════════════════════════ */
:root {
  --black:        #0a0a0a;
  --black-mid:    #111111;
  --black-card:   #141414;
  --gold:         #c9a84c;
  --gold-light:   #e0c06a;
  --gold-pale:    #f5e9c8;
  --gold-dim:     rgba(201,168,76,0.12);
  --gold-border:  rgba(201,168,76,0.28);
  --white:        #f7f4ee;
  --white-dim:    rgba(247,244,238,0.58);
  --white-faint:  rgba(247,244,238,0.07);
  --font-display: 'Cormorant Garamond', serif;
  --font-body:    'Outfit', sans-serif;
  --font-mono:    'DM Mono', monospace;
  --ease:         cubic-bezier(0.16, 1, 0.3, 1);
  --nav-h:        68px;
  --pad-x:        clamp(20px, 6vw, 80px);
  --max-w:        1100px;
  --radius:       2px;
}
 
/* ════════════════════════════════════════════════
   RESET
════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
  background: var(--black);
  color: var(--white);
  font-family: var(--font-body);
  font-weight: 300;
  line-height: 1.7;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
ul { list-style: none; }
 
/* ════════════════════════════════════════════════
   GRAIN TEXTURE
════════════════════════════════════════════════ */
body::after {
  content: '';
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
  opacity: 0.5;
}
 
/* ════════════════════════════════════════════════
   CUSTOM CURSOR (desktop only)
════════════════════════════════════════════════ */
@media (pointer: fine) {
  body { cursor: none; }
  #cur-dot, #cur-ring { display: block; }
}
@media (pointer: coarse) {
  #cur-dot, #cur-ring { display: none !important; }
}
#cur-dot {
  position: fixed; top: 0; left: 0; z-index: 9999; pointer-events: none;
  width: 8px; height: 8px; background: var(--gold); border-radius: 50%;
  transform: translate(-50%,-50%); transition: transform .1s;
}
#cur-ring {
  position: fixed; top: 0; left: 0; z-index: 9998; pointer-events: none;
  width: 38px; height: 38px; border-radius: 50%;
  border: 1.5px solid var(--gold-border);
  transform: translate(-50%,-50%);
  transition: width .35s var(--ease), height .35s var(--ease), border-color .3s;
}
#cur-ring.hovered { width: 58px; height: 58px; border-color: var(--gold); }
 
/* ════════════════════════════════════════════════
   NAVIGATION
════════════════════════════════════════════════ */
nav {
  position: fixed; inset: 0 0 auto 0; z-index: 500;
  height: var(--nav-h);
  padding: 0 var(--pad-x);
  display: flex; align-items: center; justify-content: space-between; gap: 20px;
  background: rgba(10,10,10,0.82);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-bottom: 1px solid var(--gold-border);
  transition: background .4s;
}
nav.scrolled { background: rgba(10,10,10,0.97); }
 
.nav-logo {
  display: flex; align-items: center; gap: 10px; flex-shrink: 0;
  font-family: var(--font-display); font-size: 1.25rem; font-weight: 600;
  color: var(--gold); letter-spacing: .04em;
}
.nav-logo span {
  font-family: var(--font-mono); font-weight: 300; font-size: .78rem;
  color: var(--white-dim); letter-spacing: .05em;
}
 
/* Desktop links */
.nav-links {
  display: flex; gap: 36px;
}
.nav-links a {
  font-family: var(--font-mono); font-size: .68rem; letter-spacing: .14em;
  text-transform: uppercase; color: var(--white-dim);
  position: relative; padding-bottom: 3px; transition: color .3s;
  white-space: nowrap;
}
.nav-links a::after {
  content: ''; position: absolute; bottom: 0; left: 0;
  width: 0; height: 1px; background: var(--gold);
  transition: width .3s var(--ease);
}
.nav-links a:hover, .nav-links a.active { color: var(--gold-light); }
.nav-links a:hover::after, .nav-links a.active::after { width: 100%; }
 
/* Hamburger */
.hamburger {
  display: none; flex-direction: column; gap: 5px;
  background: none; border: none; padding: 8px; cursor: pointer;
  -webkit-tap-highlight-color: transparent; z-index: 600;
}
.hamburger span {
  display: block; width: 24px; height: 1.5px;
  background: var(--gold); transition: transform .3s, opacity .3s;
}
.hamburger.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.hamburger.open span:nth-child(2) { opacity: 0; }
.hamburger.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
 
/* Mobile drawer */
.mobile-menu {
  position: fixed; inset: var(--nav-h) 0 0 0; z-index: 499;
  background: rgba(10,10,10,0.98);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0;
  transform: translateX(100%);
  transition: transform .4s var(--ease);
  padding: 40px 32px;
}
.mobile-menu.open { transform: translateX(0); }
.mobile-menu a {
  display: block; width: 100%; padding: 18px 0;
  font-family: var(--font-display); font-size: 2rem; font-weight: 300;
  color: var(--white-dim); text-align: center;
  border-bottom: 1px solid var(--gold-border);
  transition: color .3s;
}
.mobile-menu a:first-child { border-top: 1px solid var(--gold-border); }
.mobile-menu a:hover { color: var(--gold); }
 
/* ════════════════════════════════════════════════
   SHARED SECTION STYLES
════════════════════════════════════════════════ */
section {
  position: relative; z-index: 1;
  padding: clamp(70px, 12vw, 130px) var(--pad-x);
}
.inner { max-width: var(--max-w); margin: 0 auto; }
 
.sec-eyebrow {
  display: flex; align-items: center; gap: 12px;
  font-family: var(--font-mono); font-size: .65rem; letter-spacing: .2em;
  text-transform: uppercase; color: var(--gold); margin-bottom: 14px;
}
.sec-eyebrow::after { content: ''; height: 1px; width: 48px; background: var(--gold-border); }
 
.sec-title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.8rem);
  font-weight: 300; line-height: 1.08; color: var(--white);
  margin-bottom: clamp(40px, 7vw, 72px);
}
.sec-title em { color: var(--gold); font-style: italic; }
 
.gold-line {
  position: absolute; top: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(to right, transparent, var(--gold-border), transparent);
}
 
/* ════════════════════════════════════════════════
   REVEAL ANIMATIONS
════════════════════════════════════════════════ */
[data-reveal] {
  opacity: 0;
  transition: opacity .75s var(--ease), transform .75s var(--ease);
}
[data-reveal="up"]    { transform: translateY(36px); }
[data-reveal="left"]  { transform: translateX(-36px); }
[data-reveal="right"] { transform: translateX(36px); }
[data-reveal="scale"] { transform: scale(.93); }
[data-reveal].in      { opacity: 1; transform: none; }
 
[data-delay="1"] { transition-delay: .1s; }
[data-delay="2"] { transition-delay: .18s; }
[data-delay="3"] { transition-delay: .26s; }
[data-delay="4"] { transition-delay: .34s; }
[data-delay="5"] { transition-delay: .42s; }
[data-delay="6"] { transition-delay: .5s; }
 
/* ════════════════════════════════════════════════
   HERO
════════════════════════════════════════════════ */
#hero {
  min-height: 100svh;
  padding-top: calc(var(--nav-h) + clamp(40px, 8vw, 80px));
  padding-bottom: clamp(60px, 8vw, 100px);
  display: flex; align-items: center;
  overflow: hidden;
}
.hero-vline {
  position: absolute; top: 0; bottom: 0; width: 1px; pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--gold-border) 40%, transparent);
}
.hero-vline-1 { left: clamp(50%, 62%, 66%); }
.hero-vline-2 { left: clamp(35%, 46%, 50%); opacity: .35; }
 
.hero-layout {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: center;
  gap: clamp(30px, 5vw, 70px);
  width: 100%;
}
 
/* Hero text */
.hero-eyebrow {
  font-family: var(--font-mono); font-size: .68rem; letter-spacing: .22em;
  text-transform: uppercase; color: var(--gold);
  display: flex; align-items: center; gap: 14px; margin-bottom: 22px;
  opacity: 0; animation: fadeUp .8s var(--ease) .15s forwards;
}
.hero-eyebrow::before { content: ''; width: 36px; height: 1px; background: var(--gold); }
 
.hero-name {
  font-family: var(--font-display);
  font-size: clamp(3rem, 9vw, 7.8rem);
  font-weight: 300; line-height: .92; letter-spacing: -.01em; color: var(--white);
  opacity: 0; animation: fadeUp 1s var(--ease) .35s forwards;
}
.hero-name em { color: var(--gold); font-style: italic; display: block; }
 
.hero-role {
  font-family: var(--font-mono); font-size: clamp(.72rem, 1.8vw, .88rem);
  letter-spacing: .12em; text-transform: uppercase; color: var(--white-dim);
  margin-top: 26px; margin-bottom: 16px;
  opacity: 0; animation: fadeUp .8s var(--ease) .6s forwards;
}
.hero-tagline {
  font-size: clamp(.9rem, 2vw, 1.05rem); color: var(--white-dim);
  max-width: 460px; line-height: 1.85;
  opacity: 0; animation: fadeUp .8s var(--ease) .8s forwards;
}
.hero-btns {
  display: flex; flex-wrap: wrap; gap: 14px; margin-top: 40px;
  opacity: 0; animation: fadeUp .8s var(--ease) 1s forwards;
}
 
/* Buttons */
.btn {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--font-mono); font-size: .7rem; letter-spacing: .13em;
  text-transform: uppercase; padding: 13px 28px;
  transition: transform .2s, box-shadow .3s, background .25s, border-color .25s;
  white-space: nowrap; border-radius: var(--radius);
  -webkit-tap-highlight-color: transparent;
}
.btn:hover { transform: translateY(-2px); }
.btn-gold  { background: var(--gold); color: var(--black); border: none; }
.btn-gold:hover  { background: var(--gold-light); box-shadow: 0 8px 28px rgba(201,168,76,.3); }
.btn-outline { background: transparent; color: var(--gold); border: 1px solid var(--gold-border); }
.btn-outline:hover { border-color: var(--gold); background: var(--gold-dim); }
 
/* Hero stats (right column) */
.hero-stats {
  display: flex; flex-direction: column; gap: 18px;
  opacity: 0; animation: fadeIn 1s var(--ease) 1.15s forwards;
}
.stat-card {
  background: var(--black-card); border: 1px solid var(--gold-border);
  padding: 22px 26px; min-width: 148px; text-align: right;
  transition: border-color .3s, transform .3s;
}
.stat-card:hover { border-color: var(--gold); transform: translateX(-4px); }
.stat-n  { font-family: var(--font-display); font-size: 2.6rem; color: var(--gold); line-height: 1; font-weight: 600; }
.stat-lb { font-family: var(--font-mono); font-size: .6rem; letter-spacing: .15em; text-transform: uppercase; color: var(--white-dim); margin-top: 4px; }
 
/* Scroll hint */
.scroll-hint {
  position: absolute; bottom: 32px; left: var(--pad-x);
  font-family: var(--font-mono); font-size: .62rem; letter-spacing: .16em;
  text-transform: uppercase; color: var(--white-dim);
  display: flex; align-items: center; gap: 12px;
  opacity: 0; animation: fadeIn 1s var(--ease) 1.5s forwards;
}
.scroll-hint::before {
  content: ''; width: 1px; height: 48px;
  background: linear-gradient(to bottom, var(--gold), transparent);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
 
/* ════════════════════════════════════════════════
   ABOUT
════════════════════════════════════════════════ */
#about { background: var(--black-mid); }
 
.about-grid {
  display: grid;
  grid-template-columns: minmax(0,1fr) minmax(0,1.5fr);
  gap: clamp(30px, 6vw, 80px);
  align-items: start;
}
.about-big {
  font-family: var(--font-display);
  font-size: clamp(3.5rem, 8vw, 6rem);
  font-weight: 300; color: var(--gold-border);
  line-height: 1; user-select: none; letter-spacing: -.02em;
}
.about-body { font-size: clamp(.9rem, 2vw, 1.04rem); color: var(--white-dim); line-height: 1.9; }
.about-body p + p { margin-top: 18px; }
.about-body strong { color: var(--gold-light); font-weight: 400; }
 
.badge-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
.badge {
  padding: 5px 14px; border: 1px solid var(--gold-border);
  font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em;
  text-transform: uppercase; color: var(--gold);
  transition: background .25s, border-color .25s;
  border-radius: var(--radius);
}
.badge:hover { background: var(--gold-dim); border-color: var(--gold); }
 
/* ════════════════════════════════════════════════
   SKILLS
════════════════════════════════════════════════ */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: clamp(30px, 5vw, 56px) clamp(30px, 6vw, 80px);
}
.skill-group-label {
  font-family: var(--font-mono); font-size: .62rem; letter-spacing: .18em;
  text-transform: uppercase; color: var(--gold);
  padding-bottom: 12px; border-bottom: 1px solid var(--gold-border); margin-bottom: 24px;
}
.skill-row { margin-bottom: 20px; }
.skill-top { display: flex; justify-content: space-between; margin-bottom: 8px; }
.skill-name-txt { font-size: .88rem; color: var(--white); font-weight: 400; }
.skill-pct { font-family: var(--font-mono); font-size: .68rem; color: var(--gold); }
.skill-track { height: 2px; background: var(--white-faint); overflow: hidden; }
.skill-fill {
  height: 100%; width: 0;
  background: linear-gradient(to right, var(--gold), var(--gold-light));
  transition: width 1.3s var(--ease);
}
.tag-cloud { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
.tag {
  padding: 5px 13px; background: var(--white-faint); border: 1px solid rgba(247,244,238,.1);
  font-family: var(--font-mono); font-size: .62rem; letter-spacing: .1em; color: var(--white-dim);
  transition: border-color .25s, color .25s, background .25s;
  border-radius: var(--radius);
}
.tag:hover { border-color: var(--gold-border); color: var(--gold-pale); background: var(--gold-dim); }
 
/* ════════════════════════════════════════════════
   EXPERIENCE TIMELINE
════════════════════════════════════════════════ */
#experience { background: var(--black-mid); }
 
/* Desktop timeline */
.timeline { position: relative; }
.tl-center-line {
  position: absolute; top: 0; bottom: 0;
  left: 50%; transform: translateX(-50%);
  width: 1px;
  background: linear-gradient(to bottom, var(--gold-border), rgba(201,168,76,.05));
}
 
.tl-item {
  display: grid;
  grid-template-columns: 1fr 60px 1fr;
  margin-bottom: 60px;
  position: relative;
}
.tl-item:last-child { margin-bottom: 0; }
 
/* dot */
.tl-dot {
  grid-column: 2; grid-row: 1;
  display: flex; align-items: flex-start; justify-content: center;
  padding-top: 18px;
}
.tl-dot::before {
  content: ''; width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0;
  background: var(--black); border: 2px solid var(--gold);
  box-shadow: 0 0 0 5px rgba(201,168,76,.1);
}
 
/* card & meta alternate sides */
.tl-card {
  background: var(--black-card); border: 1px solid var(--gold-border);
  padding: clamp(22px, 4vw, 34px);
  transition: border-color .3s, transform .3s, box-shadow .3s;
  border-radius: var(--radius);
}
.tl-card:hover { border-color: var(--gold); transform: translateY(-4px); box-shadow: 0 12px 36px rgba(0,0,0,.5); }
 
.tl-meta { display: flex; flex-direction: column; justify-content: flex-start; padding-top: 18px; }
.tl-period {
  font-family: var(--font-mono); font-size: .62rem; letter-spacing: .14em;
  color: var(--gold); text-transform: uppercase; margin-bottom: 5px;
}
.tl-company { font-family: var(--font-display); font-size: 1.3rem; color: var(--white-dim); font-weight: 300; }
 
/* odd: card left, meta right */
.tl-item:nth-child(odd)  .tl-card { grid-column: 1; grid-row: 1; }
.tl-item:nth-child(odd)  .tl-dot  { grid-column: 2; grid-row: 1; }
.tl-item:nth-child(odd)  .tl-meta { grid-column: 3; grid-row: 1; padding-left: 18px; }
/* even: meta left, card right */
.tl-item:nth-child(even) .tl-meta { grid-column: 1; grid-row: 1; align-items: flex-end; text-align: right; padding-right: 18px; padding-left: 0; }
.tl-item:nth-child(even) .tl-dot  { grid-column: 2; grid-row: 1; }
.tl-item:nth-child(even) .tl-card { grid-column: 3; grid-row: 1; }
 
.tl-role { font-size: clamp(.95rem, 2vw, 1.08rem); font-weight: 500; color: var(--white); margin-bottom: 14px; }
.tl-points { }
.tl-points li {
  position: relative; padding-left: 18px;
  font-size: clamp(.83rem, 1.8vw, .9rem); color: var(--white-dim);
  line-height: 1.75; margin-bottom: 8px;
}
.tl-points li::before { content: '—'; position: absolute; left: 0; color: var(--gold); font-size: .78rem; }
.chip-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
.chip {
  padding: 3px 10px; background: var(--gold-dim); border: 1px solid var(--gold-border);
  font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; color: var(--gold);
  border-radius: var(--radius);
}
 
/* ════════════════════════════════════════════════
   PROJECTS
════════════════════════════════════════════════ */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
  gap: 22px;
}
.proj-card {
  background: var(--black-card); border: 1px solid var(--gold-border);
  padding: clamp(24px, 4vw, 36px); position: relative; overflow: hidden;
  transition: border-color .3s, transform .3s, box-shadow .3s;
  border-radius: var(--radius);
}
.proj-card::before {
  content: ''; position: absolute; inset: 0 0 auto 0; height: 2px;
  background: linear-gradient(to right, transparent, var(--gold), transparent);
  opacity: 0; transition: opacity .3s;
}
.proj-card:hover { border-color: var(--gold); transform: translateY(-5px); box-shadow: 0 16px 48px rgba(0,0,0,.55); }
.proj-card:hover::before { opacity: 1; }
.proj-icon {
  width: 44px; height: 44px; border: 1px solid var(--gold-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.15rem; margin-bottom: 18px;
  transition: border-color .3s, background .3s;
  border-radius: var(--radius);
}
.proj-card:hover .proj-icon { border-color: var(--gold); background: var(--gold-dim); }
.proj-title { font-family: var(--font-display); font-size: clamp(1.1rem, 2.5vw, 1.3rem); font-weight: 600; color: var(--white); margin-bottom: 10px; }
.proj-desc { font-size: clamp(.83rem, 1.8vw, .9rem); color: var(--white-dim); line-height: 1.78; }
.proj-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 18px; }
.proj-tag {
  padding: 3px 10px; border: 1px solid rgba(201,168,76,.22);
  font-family: var(--font-mono); font-size: .58rem; letter-spacing: .1em; color: var(--gold);
  border-radius: var(--radius);
}
 
/* ════════════════════════════════════════════════
   EDUCATION & CERTS
════════════════════════════════════════════════ */
.edu-layout {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  gap: clamp(24px, 5vw, 56px);
}
.edu-card {
  background: var(--black-card); border: 1px solid var(--gold-border);
  padding: clamp(22px, 4vw, 32px); margin-bottom: 16px;
  transition: border-color .3s, transform .3s;
  border-radius: var(--radius);
}
.edu-card:hover { border-color: var(--gold); transform: translateY(-3px); }
.edu-inst { font-family: var(--font-mono); font-size: .62rem; letter-spacing: .12em; color: var(--gold); text-transform: uppercase; margin-bottom: 5px; }
.edu-deg { font-family: var(--font-display); font-size: clamp(1.05rem, 2.2vw, 1.25rem); color: var(--white); font-weight: 400; margin-bottom: 4px; }
.edu-yr { font-size: .82rem; color: var(--white-dim); }
 
.cert-list { }
.cert-list li {
  display: flex; align-items: flex-start; gap: 14px;
  padding: 15px 0; border-bottom: 1px solid var(--gold-border);
  font-size: clamp(.83rem, 1.8vw, .9rem); color: var(--white-dim);
  transition: color .25s;
}
